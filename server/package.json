{
  "name": "plusticket",
  "version": "1.0.0",
  "description": "Plataforma de gestão de eventos com check-in em tempo real",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:generate": "npx prisma generate",
    "db:migrate": "npx prisma migrate dev",
    "db:migrate:prod": "npx prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:studio": "npx prisma studio",
    "db:reset": "npx prisma migrate reset",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "eventos",
    "tickets",
    "check-in",
    "qrcode",
    "websockets"
  ],
  "author": "plusTicket",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@bull-board/api": "^8.6.1",
    "@bull-board/express": "^8.6.1",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.1.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.19.1",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3",
    "stripe": "^22.5.0",
    "uuid": "^14.0.1",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "docx": "^9.7.1",
    "xlsx": "^0.18.5"
  }
}
